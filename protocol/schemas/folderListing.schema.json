{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FolderListing",
  "description": "Terminal reply to listFolder: the folder's normalized display path, its parent, its breadcrumb segments and its candidate entries, unsorted. Codes and data only; the UI words every segment, type, size and date.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "folderListing" },
    "path": { "description": "Normalized: on-disk casing, upper-case drive letter, a trailing backslash only on a root.", "type": "string", "minLength": 1 },
    "parent": { "description": "The containing folder's path; null at a drive or share root.", "type": ["string", "null"], "minLength": 1 },
    "segments": {
      "description": "Breadcrumb segments in path order. The first is the deepest known folder that contains the path, else its drive or share root.",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/knownFolderSegment" },
          { "$ref": "#/definitions/driveSegment" },
          { "$ref": "#/definitions/folderSegment" }
        ]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [{ "$ref": "#/definitions/folderEntry" }, { "$ref": "#/definitions/fileEntry" }]
      }
    }
  },
  "required": ["id", "type", "path", "parent", "segments", "entries"],
  "additionalProperties": false,
  "definitions": {
    "modified": {
      "title": "ModifiedTime",
      "description": "Last-modified time, ISO 8601 with the local offset; null when unknown.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?([+-][0-9]{2}:[0-9]{2}|Z)$"
    },
    "folderEntry": {
      "title": "FolderEntry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "const": "folder" },
        "modified": { "$ref": "#/definitions/modified" }
      },
      "required": ["name", "kind", "modified"],
      "additionalProperties": false
    },
    "fileEntry": {
      "title": "FileEntry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "const": "file" },
        "typeCode": {
          "title": "FileTypeCode",
          "enum": ["pdf", "word", "excel", "powerpoint", "text", "markdown", "image", "audio", "video", "archive", "other"]
        },
        "size": { "description": "Size in bytes.", "type": "integer", "minimum": 0 },
        "modified": { "$ref": "#/definitions/modified" }
      },
      "required": ["name", "kind", "typeCode", "size", "modified"],
      "additionalProperties": false
    },
    "knownFolderCode": {
      "title": "KnownFolderCode",
      "description": "A known folder, worded by the UI.",
      "enum": ["documents", "desktop", "downloads"]
    },
    "knownFolderSegment": {
      "title": "KnownFolderSegment",
      "type": "object",
      "properties": {
        "kind": { "const": "knownFolder" },
        "code": { "$ref": "#/definitions/knownFolderCode" },
        "path": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "code", "path"],
      "additionalProperties": false
    },
    "driveSegment": {
      "title": "DriveSegment",
      "type": "object",
      "properties": {
        "kind": { "const": "drive" },
        "letter": { "description": "Upper-case drive letter, without the colon.", "type": "string", "pattern": "^[A-Z]$" },
        "label": { "description": "The volume label; null when it has none.", "type": ["string", "null"] },
        "path": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "letter", "label", "path"],
      "additionalProperties": false
    },
    "folderSegment": {
      "title": "FolderSegment",
      "description": "A folder below the first segment, or a share root (named \\\\server\\share).",
      "type": "object",
      "properties": {
        "kind": { "const": "folder" },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "name", "path"],
      "additionalProperties": false
    }
  }
}
