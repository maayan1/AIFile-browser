{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatusReport",
  "description": "Terminal reply to status: the engine's current phase (AD-16) and how many documents it knows.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "statusReport" },
    "phase": { "enum": ["idle", "scanning", "checking", "indexing", "rebuildingForUpgrade"] },
    "documentCount": { "type": "integer", "minimum": 0 }
  },
  "required": ["id", "type", "phase", "documentCount"],
  "additionalProperties": false
}
