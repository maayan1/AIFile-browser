{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ready",
  "description": "Event sent once by the engine as its first message, within 1 s of start.",
  "type": "object",
  "properties": {
    "id": { "type": "null" },
    "type": { "const": "ready" },
    "protocolVersion": { "type": "integer", "minimum": 1 }
  },
  "required": ["id", "type", "protocolVersion"],
  "additionalProperties": false
}
