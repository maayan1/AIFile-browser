{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pong",
  "description": "Terminal reply to ping. Echoes the request id and, if given, the identical text.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "pong" },
    "text": { "type": "string" }
  },
  "required": ["id", "type"],
  "additionalProperties": false
}
